---
import './Philosophy.css';
import { philosophy } from '../data/copy';
import { headingHtml } from '../lib/split';
---
<section class="philosophy on-dark" aria-labelledby="philH">
  <div class="wrap">
    <h2 class="sr" id="philH">{philosophy.srHeading}</h2>
    <svg class="mark rv" viewBox="127 310 48 63" aria-hidden="true"><use href="#p-icon"/></svg>
    <blockquote class="qwrap"><p class="quote split" style="--d:.1s" set:html={headingHtml([philosophy.quote])}></p></blockquote>
    <span class="eyebrow both rv" style="--d:.5s">{philosophy.eyebrow}</span>
  </div>
</section>
