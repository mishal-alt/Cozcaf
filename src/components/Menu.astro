---
import './Menu.css';
import { menu } from '../data/menu';
import { menuIntro } from '../data/copy';
import { has, waHref } from '../lib/links';
import { site } from '../data/site';
import { headingHtml } from '../lib/split';

const first = menu.categories[0]?.id;
// dish photos live in public/menu/<name-as-slug>-{1024,2048}.{avif,webp}
const slug = (n: string) => n.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<section class="menu on-light" id="menu" aria-labelledby="menuH">
  <div class="wrap">
    <div class="menu-head">
      <span class="eyebrow both rv">{menuIntro.eyebrow}</span>
      <h2 class="d-l split" id="menuH" style="--d:.1s" set:html={headingHtml(menuIntro.heading)}></h2>
      <p class="b-m rv" style="--d:.25s">{menuIntro.lead}</p>
    </div>
    <div class="tabs rv" style="--d:.3s" role="tablist" aria-label={menuIntro.tabsLabel}>
      {menu.categories.map((c) => <button class="tab" role="tab" id={`tab-${c.id}`} aria-controls="panel" aria-selected={c.id === first ? 'true' : 'false'} tabindex={c.id === first ? 0 : -1} data-cat={c.id}>{c.label}</button>)}
      <span class="tab-ind" id="tab-ind" aria-hidden="true"></span>
    </div>
    <div class="panel rv" style="--d:.4s" id="panel" role="tabpanel" aria-labelledby={`tab-${first}`} tabindex="0">
      {menu.categories.map((c) => (
        <div class="menu-cols" data-cat={c.id} hidden={c.id !== first}>
          {c.items.map((it, i) => (
            <article class="dish" style={`--i:${i}`}>
              <div class="dish-ph"><svg class="dish-logo" viewBox="127 310 354 63" aria-hidden="true"><use href="#p-icon"/><use href="#p-word"/></svg><picture class="dish-img"><source type="image/avif" srcset={`/menu/${slug(it.name)}-1024.avif 1024w, /menu/${slug(it.name)}-2048.avif 2048w`} sizes="(max-width: 1100px) 45vw, 22vw" /><source type="image/webp" srcset={`/menu/${slug(it.name)}-1024.webp 1024w, /menu/${slug(it.name)}-2048.webp 2048w`} sizes="(max-width: 1100px) 45vw, 22vw" /><img src={`/menu/${slug(it.name)}-1024.webp`} alt={it.name} loading="lazy" decoding="async" /></picture>{it.tag && <span class="tag">{it.tag}</span>}</div>
              <div class="dish-body"><div class="dish-title"><h3 class="h-s">{it.name}</h3>{it.diet.length > 0 && <span class="diet">{it.diet.map((d) => d === 'Spicy'
                ? <span class="dm-spicy">{menuIntro.diet.Spicy}</span>
                : <svg class={`dm ${d === 'Veg' ? 'veg' : 'nonveg'}`} viewBox="0 0 16 16" role="img" aria-label={menuIntro.diet[d]}><title>{menuIntro.diet[d]}</title><rect x=".75" y=".75" width="14.5" height="14.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/>{d === 'Veg' ? <circle cx="8" cy="8" r="3.8" fill="currentColor"/> : <path d="M8 3.6l4.4 7.8H3.6z" fill="currentColor"/>}</svg>)}</span>}</div><p>{it.desc}</p></div>
            </article>
          ))}
        </div>
      ))}
    </div>
    <div class="menu-foot rv">
      <p class="menu-note">{menuIntro.note}</p>
      <div class="menu-actions">
        {has.wa
          ? <a class="btn primary" href={waHref('order')} target="_blank" rel="noopener">{menuIntro.whatsapp}</a>
          : has.maps && <a class="btn primary" href={site.mapsUrl} target="_blank" rel="noopener">{menuIntro.directions}</a>}
        {has.pdf && <a class="btn ghost" href={site.menuPdfUrl} target="_blank" rel="noopener">{menuIntro.pdf}</a>}
        {!has.wa && !has.pdf && has.ig && <a class="btn ghost" href={site.instagramUrl} target="_blank" rel="noopener">{menuIntro.instagram}</a>}
      </div>
    </div>
  </div>
</section>
