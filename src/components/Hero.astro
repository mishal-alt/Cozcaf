---
import './Hero.css';
import { hero } from '../data/copy';
import { openState } from '../lib/hours';
import { site } from '../data/site';

const marquee = hero.marquee.join(' • ') + ' •';
const state = openState(site.hours);
---
<section id="hero" aria-label={`${site.name}, a cozy specialty coffee cafe`}>
  <canvas id="fx" aria-hidden="true"></canvas>
  <h1 class="sr">{site.h1}</h1>
  <p id="kicker">{site.tagline}</p>
  <span class="chip" id="chip" data-open-chip data-open="true" data-opens={site.hours.open} data-closes={site.hours.close} data-tz={site.hours.tz}><i class="dot" aria-hidden="true"></i><span data-open-text>Open daily &middot; {state.range}</span></span>

  <div id="badge" aria-hidden="true">
    <svg viewBox="0 0 140 140" id="bsvg">
      <path id="bpath" d="M 70,70 m -50,0 a 50,50 0 1,1 100,0 a 50,50 0 1,1 -100,0" fill="none" stroke="transparent"/>
      <text><textPath href="#bpath" startOffset="0%">{hero.badge}</textPath></text>
    </svg>
    <div class="star">&#10033;</div>
  </div>

  <div id="bl"><span>{hero.lines[0]}</span><span>{hero.lines[1]}</span><span>{hero.lines[2]}</span></div>
  <div id="br"><div class="a">{hero.right[0]}<br>{hero.right[1]}</div>
    <div class="hero-ctas"><a class="btn primary sm" href="#menu">{hero.ctaMenu}</a><a class="btn ghost sm" href="#visit">{hero.ctaVisit}</a></div>
    <a class="cue" href="#story"><span>{hero.cue}</span><span class="cb" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#F4EFE6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></a></div>

  <div id="marq" aria-hidden="true"><div class="track"><span class="mq"><span class="mq-open">Open daily &middot; {state.range} &bull; </span>{marquee}</span><span class="mq"><span class="mq-open">Open daily &middot; {state.range} &bull; </span>{marquee}</span></div></div>
</section>
