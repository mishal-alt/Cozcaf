---
import './Gallery.css';
import Picture from './Picture.astro';
import { gallery } from '../data/copy';
import { site } from '../data/site';
import { has } from '../lib/links';
import { headingHtml } from '../lib/split';

// the wide first tile and the tall second one ask for more pixels than the squares
const sizes = ['(max-width:600px) 92vw, 62vw', '(max-width:600px) 46vw, 31vw', '(max-width:600px) 46vw, 31vw'];
---
<section class="gallery on-dark" id="gallery" aria-labelledby="galH">
  <div class="wrap">
    <div class="g-intro">
      <div class="g-copy">
        <span class="eyebrow rv">{gallery.eyebrow}</span>
        <h2 class="d-l split" id="galH" style="--d:.1s" set:html={headingHtml(gallery.heading)}></h2>
      </div>
      <div class="g-side rv" style="--d:.25s">
        <p class="b-m">{gallery.aside}</p>
        {has.ig && <a class="link" href={site.instagramUrl} target="_blank" rel="noopener"><span>{site.instagramHandle}</span> on Instagram <svg viewBox="0 0 28 12" aria-hidden="true"><use href="#arrow"/></svg></a>}
      </div>
    </div>
    <ul class="g-grid">
      {gallery.tiles.map((t, i) => (
        <li><button class="g-tile rv-img zoom" type="button" data-i={i} style={i % 3 ? `--d:${(i % 3) / 10}s` : undefined} aria-label={`Open photo: ${t.alt}`}><Picture name={t.name} alt={t.alt} sizes={sizes[Math.min(i, 2)] ?? ''} /></button></li>
      ))}
    </ul>
  </div>
</section>
