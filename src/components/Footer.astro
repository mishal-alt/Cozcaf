---
import './Footer.css';
import { footer } from '../data/copy';
import { site } from '../data/site';
import { has, mailHref, telHref, waHref } from '../lib/links';
import { headingHtml } from '../lib/split';
import { openState } from '../lib/hours';

const state = openState(site.hours);
const year = new Date().getFullYear();
---
<footer class="footer on-dark" aria-labelledby="footH">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-cta">
        <h2 class="d-m split" id="footH" set:html={headingHtml(footer.heading)}></h2>
        <p class="b-m rv" style="--d:.2s">{footer.lead}</p>
        <div class="foot-btns rv" style="--d:.3s">
          {has.wa && <a class="btn primary on-darkbtn" href={waHref('order')} target="_blank" rel="noopener">{footer.whatsapp}</a>}
          {has.ig && <a class="btn ghost on-darkbtn" href={site.instagramUrl} target="_blank" rel="noopener">{footer.instagram}</a>}
        </div>
        <ul class="socials rv" style="--d:.4s" aria-label={footer.socialsLabel}>
          {has.ig && <li><a href={site.instagramUrl} target="_blank" rel="noopener" aria-label={`${site.name} on Instagram`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r=".6" fill="currentColor"/></svg></a></li>}
          {has.wa && <li><a href={waHref('order')} target="_blank" rel="noopener" aria-label={`Message ${site.name} on WhatsApp`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/></svg></a></li>}
          {has.maps && <li><a href={site.mapsUrl} target="_blank" rel="noopener" aria-label={`${site.name} on Google Maps`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21.5s-7-6.2-7-11.5a7 7 0 0 1 14 0c0 5.3-7 11.5-7 11.5z"/><circle cx="12" cy="10" r="2.6"/></svg></a></li>}
        </ul>
      </div>
      <div class="foot-cols rv" style="--d:.3s">
        <div><h3>{footer.exploreHeading}</h3><ul>{footer.explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
        <div><h3>{footer.visitHeading}</h3><address><span>{site.landmark}</span><br><span>{site.locality}</span></address><p class="hrs"><span>{site.hours.label}</span>, <span>{state.range}</span></p>{has.phone && <p><a class="tel" href={telHref}>{site.phone}</a></p>}{has.email && <p><a class="mail" href={mailHref}>{site.email}</a></p>}</div>
      </div>
    </div>
    <svg class="bigmark rv-wipe" viewBox="127 310 354 63" aria-hidden="true"><use href="#p-icon"/><use href="#p-word"/></svg>
    <div class="foot-bottom"><span>&copy; <span id="yr">{year}</span> {footer.copyright}</span><a class="to-top" href="#page">{footer.toTop} <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 10V2M2.5 5.5 6 2l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
  </div>
</footer>
