---
import { ICON_PATH, WORD_PATH } from './logo-paths';
---
<!-- shared SVG symbols: the bean mark, the COZCAF lettering and the link arrow -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <path id="p-icon" pathLength="1" fill-rule="evenodd" d={ICON_PATH} />
    <path id="p-word" fill-rule="evenodd" d={WORD_PATH} />
    <path id="arrow" d="M0 6H26M21 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2" />
  </defs>
</svg>
