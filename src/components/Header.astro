---
import './Header.css';
import { ICON_PATH, COZ_LETTERS, CAF_LETTERS } from './logo-paths';
import { nav } from '../data/copy';
import { has, waHref } from '../lib/links';
import { site } from '../data/site';
import { openState } from '../lib/hours';

const range = openState(site.hours).range;
const letters = [...COZ_LETTERS, ...CAF_LETTERS];
---
<header id="hdr">
  <div id="hdrBg" aria-hidden="true"></div>
  <div id="hdrIn">
    <a class="logoLink" id="logoLink" href="#page" tabindex="-1" aria-label={`${site.name}, back to the top`}>
      <svg id="wm" viewBox="127 310 354 63" aria-hidden="true" focusable="false">
        <path id="wmIcon" fill-rule="evenodd" d={ICON_PATH}/>
        <g fill-rule="evenodd">{letters.map((l) => <path class="wl" d={l.d}/>)}</g>
        <clipPath id="wmClip">{letters.map((l) => <path d={l.d}/>)}</clipPath>
        <g clip-path="url(#wmClip)"><rect id="sheen" x="0" y="312" width="46" height="58" fill="url(#wmSheen)" opacity="0"/></g>
        <linearGradient id="wmSheen" x1="0" x2="1"><stop offset="0" stop-color="#ffb255" stop-opacity="0"/><stop offset=".5" stop-color="#ffb255" stop-opacity=".95"/><stop offset="1" stop-color="#ffb255" stop-opacity="0"/></linearGradient>
      </svg>
    </a>
    <nav id="nav" aria-label="Primary">{nav.map((n) => <a href={`#${n.id}`} data-sec={n.id}>{n.label}</a>)}</nav>
    <div id="hr">
      {has.wa ? (
        <a class="wa" id="wa" href={waHref('order')} target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/></svg><span class="long">Order on WhatsApp</span><span class="short">Order</span></a>
      ) : (
        <a class="wa" id="find" href="#visit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg><span class="long">Find us</span><span class="short">Find us</span></a>
      )}
      <a class="rnd dock" id="dock" href="#menu" aria-label="Jump to the menu"><svg class="glyph" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F4EFE6" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11h12v3.5A5.5 5.5 0 0 1 10.5 20h-1A5.5 5.5 0 0 1 4 14.5V11z"/><path d="M16 12.5h1.3a2.3 2.3 0 0 1 0 4.6H15.6"/><path d="M8 3.5c-.9 1 .9 2-.1 3.4M11.8 3.5c-.9 1 .9 2-.1 3.4"/></svg></a>
      <button class="rnd" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sheet"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F4EFE6" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="l1" d="M4 8h16"/><path class="l2" d="M4 16h16"/></svg></button>
    </div>
  </div>
  <div id="sheet" tabindex="-1" hidden>
    <nav class="sh-links" aria-label="Menu">{nav.map((n, i) => <a href={`#${n.id}`} style={`--i:${i}`}><span class="n" aria-hidden="true">0{i + 1}</span><span class="mk"><span class="t">{n.label}</span></span></a>)}</nav>
    <div class="sh-foot">
      {has.wa
        ? <a class="btn primary" href={waHref('order')} target="_blank" rel="noopener">Order on WhatsApp</a>
        : <a class="btn primary" href="#visit">Find us</a>}
      <p class="sh-meta">{has.ig && <a href={site.instagramUrl} target="_blank" rel="noopener">{site.instagramHandle}</a>}<span>Open daily &middot; {range}</span></p>
    </div>
  </div>
</header>
