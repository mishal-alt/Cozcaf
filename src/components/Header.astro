---
import './Header.css';
import logoUrl from '../assets/hero/logo.png?url';
import { nav } from '../data/copy';
import { has, waHref } from '../lib/links';
import { site } from '../data/site';
---
<header id="hdr">
  <div id="hdrIn">
    <a class="logoLink anim" id="logoLink" href="#page" aria-label={`${site.name}, back to the top`}><img alt={site.name} src={logoUrl} width="313" height="54"></a>
    <nav id="nav" class="anim" aria-label="Primary">{nav.map((n) => <a href={`#${n.id}`} data-sec={n.id}>{n.label}</a>)}</nav>
    <div id="hr" class="anim">
      {has.wa ? (
        <a class="wa" id="wa" href={waHref('order')} target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/></svg><span class="long">Order on WhatsApp</span><span class="short">Order</span></a>
      ) : (
        <a class="wa" id="find" href="#visit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg><span class="long">Find us</span><span class="short">Find us</span></a>
      )}
      <a class="rnd dock" id="dock" href="#menu" aria-label="Jump to the menu"><svg class="glyph" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4EFE6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9h10l-1.2 11H8.2L7 9z"/><path d="M6 9h12"/><path d="M8.5 5.5h7L17 9H7l1.5-3.5z"/></svg></a>
      <button class="rnd" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sheet"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F4EFE6" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg></button>
    </div>
    <div id="sheet" hidden>{nav.map((n) => <a href={`#${n.id}`}>{n.label}</a>)}</div>
  </div>
</header>
