---
import './Craft.css';
import Picture from './Picture.astro';
import Clip from './Clip.astro';
import { craft } from '../data/copy';
import { headingHtml } from '../lib/split';
import { site } from '../data/site';
import { fmt12 } from '../lib/hours';
import { has, waHref } from '../lib/links';

const b = craft.beans;
const src = (ext: string) => `/menu/${b.photo.slug}-1024.${ext} 1024w, /menu/${b.photo.slug}-2048.${ext} 2048w`;

const stats = [
  [site.since.replace(/\D/g, ''), craft.stats.since],
  [fmt12(site.hours.close), craft.stats.close],
  ['7', craft.stats.days],
] as const;
---
<section class="craft on-light" id="story" aria-labelledby="craftH">
  <div class="wrap">
    <figure class="collage">
      <div class="big rv-img"><Clip name={craft.reel.name} label={craft.reel.label} /></div>
      <div class="small-wrap" data-px="-0.07"><div class="small rv-img zoom" style="--d:.35s"><Picture name={craft.small.name} alt={craft.small.alt} sizes="(max-width:900px) 40vw, 18vw" /></div></div>
      <figcaption class="rv" style="--d:.5s">{craft.caption}</figcaption>
    </figure>
    <div class="craft-copy">
      <span class="eyebrow rv">{craft.eyebrow}</span>
      <h2 class="d-l split" id="craftH" style="--d:.1s" set:html={headingHtml(craft.heading)}></h2>
      <p class="b-l rv" style="--d:.2s">{craft.lead}</p>
      <p class="b-m rv" style="--d:.3s">{craft.body}</p>
      <ul class="ticks">{craft.ticks.map((t, i) => <li class="rv" style={`--d:${['.35s', '.45s', '.55s'][i]}`}>{t}</li>)}</ul>
      <aside class="beans rv" style="--d:.6s" aria-labelledby="beansH">
        <div class="dish-ph beans-ph"><svg class="dish-logo" viewBox="127 310 354 63" aria-hidden="true"><use href="#p-icon"/><use href="#p-word"/></svg><picture class="dish-img"><source type="image/avif" srcset={src('avif')} sizes="(max-width: 900px) 34vw, 180px" /><source type="image/webp" srcset={src('webp')} sizes="(max-width: 900px) 34vw, 180px" /><img src={`/menu/${b.photo.slug}-1024.webp`} alt={b.photo.alt} loading="lazy" decoding="async" /></picture></div>
        <div class="beans-body">
          <span class="tag">{b.tag}</span>
          <h3 class="h-s" id="beansH">{b.title}</h3>
          <p>{b.text}</p>
          {has.wa
            ? <a class="link" href={waHref('beans')} target="_blank" rel="noopener">{b.order} <svg viewBox="0 0 28 12" aria-hidden="true"><use href="#arrow"/></svg></a>
            : <span class="beans-note">{b.counter}</span>}
        </div>
      </aside>
      <dl class="stats rv" style="--d:.7s">{stats.map(([v, l]) => <div><dt>{l}</dt><dd>{v}</dd></div>)}</dl>
      <a class="link rv" style="--d:.8s" href="#menu">{craft.link} <svg viewBox="0 0 28 12" aria-hidden="true"><use href="#arrow"/></svg></a>
    </div>
  </div>
</section>
