---
import './Visit.css';
import Picture from './Picture.astro';
import { visit } from '../data/copy';
import { site } from '../data/site';
import { has, telHref, waHref } from '../lib/links';
import { headingHtml } from '../lib/split';
import { openState } from '../lib/hours';

const state = openState(site.hours);
const H = visit.headings;
---
<section class="visit on-light" id="visit" aria-labelledby="visitH">
  <div class="wrap">
    <div class="visit-head">
      <span class="eyebrow rv">{visit.eyebrow}</span>
      <h2 class="d-l split" id="visitH" style="--d:.1s" set:html={headingHtml(visit.heading)}></h2>
      <span class="chip chip-light rv" style="--d:.25s" data-open-chip data-open="true" data-opens={site.hours.open} data-closes={site.hours.close} data-tz={site.hours.tz}><i class="dot" aria-hidden="true"></i><span data-open-text>Open daily &middot; {state.range}</span></span>
    </div>
    <div class="visit-media rv-img zoom">
      {has.embed
        ? <div class="map-embed"><iframe src={site.mapEmbedUrl} title={visit.mapEmbedTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
        : <Picture name={visit.photo.name} alt={visit.photo.alt} sizes="(max-width: 900px) 100vw, 600px" />}
      {has.maps && (
        <a class="visit-pin" href={site.mapsUrl} target="_blank" rel="noopener" aria-label={visit.mapLabel}>
          <svg class="pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.5s-7-6.2-7-11.5a7 7 0 0 1 14 0c0 5.3-7 11.5-7 11.5z" fill="currentColor"/><circle cx="12" cy="10" r="2.6" fill="#2E3827"/></svg>
          <span class="pin-text"><span class="pin-name">{site.name}</span><span class="pin-go">{visit.mapGo}</span></span>
          <svg class="arrow" viewBox="0 0 28 12" aria-hidden="true"><use href="#arrow"/></svg>
        </a>
      )}
    </div>
    <div class="visit-facts rv" style="--d:.35s">
      <div class="facts">
        <div><h3>{H.find}</h3><p><span>{site.landmark}</span>, <span>{site.locality}</span>{has.parking && <><br><span>{site.parking}</span></>}</p></div>
        <div><h3>{H.hours}</h3><p><span>{site.hours.label}</span>, <span>{state.range}</span></p></div>
        <div><h3>{H.reservations}</h3><p>{has.phone && <><a class="tel" href={telHref}>{site.phone}</a><br></>}{has.wa ? <a class="inline" href={waHref('reserve')} target="_blank" rel="noopener">{visit.bookWhatsapp}</a> : <span>{visit.walkIns}</span>}</p></div>
      </div>
      <div class="ctas">
        {has.maps && <a class="btn primary" href={site.mapsUrl} target="_blank" rel="noopener">{visit.directions}</a>}
        {has.wa && <a class="btn ghost" href={waHref('reserve')} target="_blank" rel="noopener">{visit.reserve}</a>}
      </div>
    </div>
  </div>
</section>
