---
import './Story.css';
import Picture from './Picture.astro';
import { story } from '../data/copy';
import { headingHtml } from '../lib/split';

const sizes = '(max-width:680px) 92vw, (max-width:1100px) 31vw, 400px';
const delays = [['0s', '.55s'], ['.15s', '.7s'], ['.3s', '.85s']] as const;
---
<section class="story on-light" id="story" aria-labelledby="storyH">
  <div class="wrap">
    <svg class="mark rv" viewBox="127 310 48 63" aria-hidden="true"><use href="#p-icon"/></svg>
    <span class="eyebrow both rv" style="--d:.1s">{story.eyebrow}</span>
    <h2 class="d-m split" id="storyH" style="--d:.15s" set:html={headingHtml(story.heading)}></h2>
    <p class="b-l rv" style="--d:.25s">{story.lead}</p>
    <div class="pillars">
      {story.pillars.map((p, i) => (
        <article class="pillar">
          <div class="pillar-media rv-img zoom" style={`--d:${delays[i]?.[0]}`}><Picture name={p.photo.name} alt={p.photo.alt} sizes={sizes} /></div>
          <div class="pillar-copy rv" style={`--d:${delays[i]?.[1]}`}><span class="num">{p.num}</span><h3 class="h-s">{p.title}</h3><p class="b-m">{p.text}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>
