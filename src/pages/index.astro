---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Icons from '../components/Icons.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Craft from '../components/Craft.astro';
import Signatures from '../components/Signatures.astro';
import Menu from '../components/Menu.astro';
import Philosophy from '../components/Philosophy.astro';
import Visit from '../components/Visit.astro';
import Gallery from '../components/Gallery.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
---
<Base>
  <Loader />
  <Icons />
  <Header />
  <Hero />
  <div id="page">
    <div id="spacer"></div>
    <div id="site">
      <Ticker />
      <main id="content" tabindex="-1">
        <Craft />
        <Signatures />
        <Menu />
        <Philosophy />
        <Visit />
        <Gallery />
      </main>
      <Footer />
    </div>
  </div>
  <Lightbox />
  <script>
    import '../scripts/main';
  </script>
</Base>
